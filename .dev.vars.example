# Local dev secrets for `wrangler pages dev`.
# Copy this file to `.dev.vars` (gitignored) and fill in your values.

# Signs the proof-of-work CAPTCHA challenges. Any long random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET=replace_me_with_a_long_random_string

# Password for the seeded admin account. Kept in sync with this value on
# every boot — rotate it here any time.
ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_USERNAME=admin   # optional, defaults to "admin"

# Signs the /account/license token the desktop loader verifies a member's
# tier with. Optional — falls back to CAPTCHA_SECRET if unset.
# LICENSE_SECRET=replace_me_with_a_different_long_random_string

# Where the real installer lives. Fetched server-side by /download/file and
# streamed straight through — the URL itself is never sent to the browser.
# Required for downloads to work — no fallback. Leave unset in dev and
# /download/file will correctly return "unavailable" rather than fake content.
# DOWNLOAD_URL=https://example.com/path/to/GoyHub-Setup-1.0.0.zip

# Outbound email (optional in dev). Use provider "test" to capture messages
# in-process (the smoke tests do), or a real provider + key.
# EMAIL_PROVIDER=test
# EMAIL_FROM=no-reply@goyhub.st

# Cloudflare Turnstile (optional). Cloudflare's public ALWAYS-PASS test keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# BTCPay Server crypto checkout (optional). Set all of these to turn the
# /upgrade page into a real one-click crypto checkout that upgrades the account
# automatically once a payment confirms. Full guide: BTCPAY-SETUP.md.
# BTCPAY_URL=https://btcpay.example.com
# BTCPAY_STORE_ID=your-store-id
# BTCPAY_API_KEY=your-greenfield-api-key
# BTCPAY_WEBHOOK_SECRET=the-store-webhook-signing-secret
# PAID_PRICE_AMOUNT=10.00
# PAID_PRICE_CURRENCY=USD
# PAID_PERIOD_DAYS=30       # empty or 0 = lifetime membership

# Direct-to-wallet crypto payments (optional). Paste your OWN receiving
# addresses and /buy gains a coin picker for ETH, SOL and USDT; the site
# watches the chain and upgrades the account once a payment confirms. Runs
# happily alongside BTCPay, or instead of it. Full guide: CRYPTO-SETUP.md.
#
# Nothing here holds or needs a private key — these are receive-only addresses
# and every chain call is read-only.
# ETH_ADDRESS=0x0000000000000000000000000000000000000000
# SOL_ADDRESS=YourBase58SolanaAddressHere

# Lets an external cron drive the chain watcher (GET or POST
# /api/crypto/scan?key=...), so payments confirm while nobody is browsing.
# Unset, the endpoint is closed to everyone.
# CRYPTO_SCAN_SECRET=another_long_random_string

# The chain and price APIs are keyless by default (Blockscout, the Solana
# mainnet RPC, Coinbase). Set these only if you want higher rate limits.
# ETHERSCAN_API_KEY=
# SOLANA_RPC_URL=
# COINGECKO_API_KEY=
