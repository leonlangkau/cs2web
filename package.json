{
  "name": "goyhub-web",
  "version": "1.0.0",
  "description": "AimHub: CS2 companion app site, community forum and secured admin backend. A Cloudflare Pages project (static public/ + one catch-all Pages Function backed by D1).",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build-schema.cjs && node scripts/build-installer.cjs",
    "dev": "wrangler pages dev",
    "test": "node --test",
    "db:local": "wrangler d1 execute goyhub --local --file=schema.sql",
    "db:remote": "wrangler d1 execute goyhub --remote --file=schema.sql",
    "deploy": "wrangler pages deploy",
    "tail": "wrangler pages deployment tail"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
