# Cache-Control rules for Cloudflare Pages.
# Dynamic HTML is served by the catch-all Function (which sets its own
# no-store/Cache-Control), so only the static assets under public/ are covered here.

# CSS / JS / fonts are referenced with a ?v=<content-hash> stamp generated by
# scripts/build-assets.cjs, so a URL only repeats while the bytes are identical
# and these can be cached hard. Do NOT weaken this to max-age=0: Cloudflare
# overrides any Cache-Control below the zone's Browser Cache TTL (4 hours by
# default), which is what previously left returning visitors on a stale
# stylesheet after a deploy.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and the installer artifact aren't here — the installer lives outside
# public/ so it can only be fetched through the audited /download/file route.
