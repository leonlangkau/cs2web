<%- include('../partials/header', { title: title }) %>
<section class="section admin-page">
  <div class="container">
    <%- include('../partials/adminnav', { heading: 'Dashboard' }) %>

    <div class="stat-cards">
      <div class="stat-card"><span class="stat-card-value"><%= stats.users %></span><span class="stat-card-label">Users</span></div>
      <div class="stat-card"><span class="stat-card-value"><%= stats.sessions %></span><span class="stat-card-label">Active sessions</span></div>
      <div class="stat-card"><span class="stat-card-value"><%= stats.threads %></span><span class="stat-card-label">Threads</span></div>
      <div class="stat-card"><span class="stat-card-value"><%= stats.posts %></span><span class="stat-card-label">Posts</span></div>
      <div class="stat-card"><span class="stat-card-value"><%= stats.downloads %></span><span class="stat-card-label">Downloads</span></div>
      <div class="stat-card"><span class="stat-card-value"><%= stats.signups24h %></span><span class="stat-card-label">Signups (24h)</span></div>
      <div class="stat-card <%= stats.failedLogins24h > 20 ? 'stat-card-warn' : '' %>"><span class="stat-card-value"><%= stats.failedLogins24h %></span><span class="stat-card-label">Failed logins (24h)</span></div>
      <div class="stat-card <%= stats.banned > 0 ? 'stat-card-warn' : '' %>"><span class="stat-card-value"><%= stats.banned %></span><span class="stat-card-label">Banned users</span></div>
    </div>

    <div class="admin-columns">
      <div class="panel">
        <div class="panel-head"><h2>Latest activity</h2><a class="muted" href="/admin/logs">All logs →</a></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Event</th><th>User</th><th>IP</th><th>When</th></tr></thead>
            <tbody>
              <% recentLogs.forEach(function (l) { %>
                <tr>
                  <td><span class="tag tag-event tag-<%= l.event %>"><%= l.event %></span></td>
                  <td><%= l.username || '—' %></td>
                  <td class="mono"><%= l.ip %></td>
                  <td class="muted"><%= timeAgo(l.created_at) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><h2>Newest users</h2><a class="muted" href="/admin/users">All users →</a></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>User</th><th>Signup IP</th><th>Joined</th></tr></thead>
            <tbody>
              <% recentUsers.forEach(function (u) { %>
                <tr>
                  <td>
                    <%= u.username %>
                    <% if (u.role === 'admin') { %><span class="tag tag-admin">ADMIN</span><% } %>
                    <% if (u.banned) { %><span class="tag tag-banned">BANNED</span><% } %>
                  </td>
                  <td class="mono"><%= u.signup_ip || '—' %></td>
                  <td class="muted"><%= timeAgo(u.created_at) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
