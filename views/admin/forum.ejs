<%- include('../partials/header', { title: title }) %>
<section class="section admin-page">
  <div class="container">
    <%- include('../partials/adminnav', { heading: 'Forum management' }) %>

    <div class="admin-columns">
      <div class="panel">
        <div class="panel-head"><h2>Categories</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Slug</th><th>Threads</th><th></th></tr></thead>
            <tbody>
              <% categories.forEach(function (c) { %>
                <tr>
                  <td><strong><%= c.name %></strong><div class="muted"><%= c.description %></div></td>
                  <td class="mono"><%= c.slug %></td>
                  <td><%= c.thread_count %></td>
                  <td class="actions-cell">
                    <form method="post" action="/admin/categories/<%= c.id %>/delete" class="inline-form"
                          data-confirm="Delete category '<%= c.name %>' and ALL <%= c.thread_count %> of its threads?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <form method="post" action="/admin/categories" class="stack panel-form">
          <h3>Add category</h3>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label><span>Name</span><input type="text" name="name" required minlength="2" maxlength="50"></label>
          <label><span>Description</span><input type="text" name="description" maxlength="300"></label>
          <button class="btn btn-primary btn-sm" type="submit">Create</button>
        </form>
      </div>

      <div class="panel">
        <div class="panel-head"><h2>Latest threads</h2></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Thread</th><th>Posts</th><th>Actions</th></tr></thead>
            <tbody>
              <% threads.forEach(function (t) { %>
                <tr>
                  <td>
                    <a href="/forum/t/<%= t.id %>"><%= t.title %></a>
                    <% if (t.pinned) { %><span class="tag tag-pin">PIN</span><% } %>
                    <% if (t.locked) { %><span class="tag tag-lock">LOCK</span><% } %>
                    <div class="muted"><%= t.category_name %> · <%= t.username %> · <%= timeAgo(t.updated_at) %></div>
                  </td>
                  <td><%= t.post_count %></td>
                  <td class="actions-cell">
                    <form method="post" action="/admin/threads/<%= t.id %>/pin" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-ghost btn-xs" type="submit"><%= t.pinned ? 'Unpin' : 'Pin' %></button>
                    </form>
                    <form method="post" action="/admin/threads/<%= t.id %>/lock" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-ghost btn-xs" type="submit"><%= t.locked ? 'Unlock' : 'Lock' %></button>
                    </form>
                    <form method="post" action="/admin/threads/<%= t.id %>/delete" class="inline-form"
                          data-confirm="Delete thread '<%= t.title %>' and all replies?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-xs" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
