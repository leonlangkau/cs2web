<%- include('../partials/header', { title: title }) %>
<section class="section admin-page">
  <div class="container">
    <%- include('../partials/adminnav', { heading: 'IP logs' }) %>

    <form method="get" action="/admin/logs" class="filter-bar">
      <select name="event" aria-label="Filter by event type">
        <option value="">All events</option>
        <% events.forEach(function (e) { %>
          <option value="<%= e %>" <%= event === e ? 'selected' : '' %>><%= e %></option>
        <% }) %>
      </select>
      <input type="search" name="q" value="<%= q %>" aria-label="Filter logs by IP, username or detail" placeholder="Filter by IP, username or detail…">
      <button class="btn btn-outline" type="submit">Filter</button>
      <% if (q || event) { %><a class="btn btn-ghost" href="/admin/logs">Clear</a><% } %>
      <span class="muted"><%= total %> entr<%= total === 1 ? 'y' : 'ies' %></span>
    </form>

    <div class="panel">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>#</th><th>Event</th><th>User</th><th>IP address</th><th>Detail</th><th>User agent</th><th>When</th></tr>
          </thead>
          <tbody>
            <% if (logs.length === 0) { %>
              <tr><td colspan="7" class="muted center">No log entries match.</td></tr>
            <% } %>
            <% logs.forEach(function (l) { %>
              <tr>
                <td class="muted"><%= l.id %></td>
                <td><span class="tag tag-event tag-<%= l.event %>"><%= l.event %></span></td>
                <td><%= l.username || '—' %></td>
                <td class="mono"><a href="/admin/logs?q=<%= encodeURIComponent(l.ip) %>"><%= l.ip %></a></td>
                <td class="muted detail-cell"><%= l.detail || '—' %></td>
                <td class="muted ua-cell" title="<%= l.user_agent || '' %>"><%= (l.user_agent || '—').slice(0, 60) %></td>
                <td class="muted nowrap"><%= l.created_at %> UTC</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (pages > 1) { %>
      <nav class="pagination" aria-label="Pages">
        <% pageWindow(page, pages).forEach(function (p) { %>
          <% if (p === '…') { %><span class="page gap" aria-hidden="true">…</span>
          <% } else if (p === page) { %><span class="page current" aria-current="page"><%= p %></span>
          <% } else { %><a class="page" href="/admin/logs?page=<%= p %>&event=<%= encodeURIComponent(event) %>&q=<%= encodeURIComponent(q) %>"><%= p %></a><% } %>
        <% }) %>
      </nav>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
