<%- include('../partials/header', { title: title }) %>
<section class="section forum-page">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/forum">Forum</a> <span aria-hidden="true">/</span> <span><%= category.name %></span>
    </nav>
    <div class="page-head">
      <div>
        <h1 class="section-title"><%= category.name %></h1>
        <p class="muted"><%= category.description %></p>
      </div>
      <% if (user) { %>
        <a class="btn btn-primary" href="/forum/new?c=<%= encodeURIComponent(category.slug) %>">+ New thread</a>
      <% } else { %>
        <a class="btn btn-primary" href="/auth/login?next=<%= encodeURIComponent('/forum/new?c=' + category.slug) %>">Log in to post</a>
      <% } %>
    </div>

    <% if (threads.length === 0) { %>
      <p class="muted empty-state">No threads here yet. Start the first one!</p>
    <% } else { %>
      <div class="thread-list">
        <% threads.forEach(function (t) { %>
          <a class="thread-row" href="/forum/t/<%= t.id %>">
            <div class="thread-flags" aria-hidden="true">
              <% if (t.pinned) { %><span class="tag tag-pin">PINNED</span><% } %>
              <% if (t.locked) { %><span class="tag tag-lock">LOCKED</span><% } %>
            </div>
            <div class="thread-main">
              <span class="thread-title"><%= t.title %></span>
              <span class="muted">by <%= t.username %> · <%= timeAgo(t.created_at) %></span>
            </div>
            <div class="thread-nums">
              <span><strong><%= Math.max(0, t.replies) %></strong> replies</span>
              <span><strong><%= t.views %></strong> views</span>
              <span class="muted">active <%= timeAgo(t.last_post_at || t.updated_at) %></span>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (pages > 1) { %>
        <nav class="pagination" aria-label="Pages">
          <% for (let p = 1; p <= pages; p++) { %>
            <% if (p === page) { %><span class="page current"><%= p %></span>
            <% } else { %><a class="page" href="/forum/c/<%= category.slug %>?page=<%= p %>"><%= p %></a><% } %>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
