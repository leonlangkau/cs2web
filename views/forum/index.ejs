<%- include('../partials/header', { title: title }) %>
<section class="section forum-page">
  <div class="container">
    <div class="page-head">
      <div>
        <p class="section-kicker">// COMMUNITY</p>
        <h1 class="section-title">Forum</h1>
      </div>
      <% if (user) { %>
        <a class="btn btn-primary" href="/forum/new">+ New thread</a>
      <% } else { %>
        <a class="btn btn-primary" href="/auth/signup">Sign up to post</a>
      <% } %>
    </div>

    <div class="forum-layout">
      <div class="category-list">
        <% categories.forEach(function (c) { %>
          <a class="category-card" href="/forum/c/<%= c.slug %>">
            <div class="category-main">
              <h2><%= c.name %></h2>
              <p class="muted"><%= c.description %></p>
            </div>
            <div class="category-stats">
              <span><strong><%= c.thread_count %></strong> threads</span>
              <span><strong><%= c.post_count %></strong> posts</span>
            </div>
            <div class="category-latest">
              <% if (c.latest_title) { %>
                <span class="latest-title"><%= c.latest_title %></span>
                <span class="muted"><%= timeAgo(c.latest_at) %></span>
              <% } else { %>
                <span class="muted">No threads yet</span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>

      <aside class="forum-sidebar" aria-label="Recent activity">
        <h2>Recent activity</h2>
        <% if (recent.length === 0) { %><p class="muted">Nothing yet.</p><% } %>
        <% recent.forEach(function (t) { %>
          <a class="sidebar-thread" href="/forum/t/<%= t.id %>">
            <span class="sidebar-title"><%= t.title %></span>
            <span class="muted"><%= t.category %> · <%= t.username %> · <%= timeAgo(t.updated_at) %></span>
          </a>
        <% }) %>
      </aside>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
