<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? `${title} · ${appName}` : `${appName} — The Ultimate CS2 Companion` %></title>
  <meta name="description" content="GoyHub is the all-in-one CS2 companion app: match stats, crosshair & config manager, skin tracker and performance presets. Free download.">
  <%# White backing plate so the blue mark stays visible in dark browser tab strips. %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23ffffff'/%3E%3Cpath d='M16 5L25.5 21.5H6.5z' fill='none' stroke='%230137B7' stroke-width='2.6' stroke-linejoin='round'/%3E%3Cpath d='M16 27L6.5 10.5h19z' fill='none' stroke='%230137B7' stroke-width='2.6' stroke-linejoin='round'/%3E%3C/svg%3E">
  <meta name="theme-color" content="#0137B7">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/boot.js"></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-nav" id="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="GoyHub home">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 4L26.4 22H5.6z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M16 28L5.6 10h20.8z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
      </svg>
      <span>Goy<em>Hub</em></span>
    </a>
    <nav class="nav-links" aria-label="Main">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
      <a href="/forum" class="<%= path.startsWith('/forum') ? 'active' : '' %>">Forum</a>
      <a href="/download" class="<%= path.startsWith('/download') ? 'active' : '' %>">Download</a>
      <% if (user && user.role === 'admin') { %>
        <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a>
      <% } %>
    </nav>
    <div class="nav-auth">
      <% if (user) { %>
        <span class="nav-user"><span class="avatar" aria-hidden="true"><%= user.username[0].toUpperCase() %></span><%= user.username %></span>
        <form method="post" action="/auth/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">Log in</a>
        <a href="/auth/signup" class="btn btn-primary btn-sm">Sign up</a>
      <% } %>
    </div>
  </div>
</header>
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status">
    <div class="container"><%= flash.message %></div>
  </div>
<% } %>
<% if (needsTermsGate) { %><%- include('termsgate') %><% } %>
<main id="main">
